# Copie para .env e ajuste. JWT_SECRET é obrigatório (mínimo 32 caracteres).
# Gere um valor seguro com: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg2://crm:crm@localhost:5432/crm
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-48-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=development
